# Copy to .env and fill in. Never commit .env.

# Bot token: Discord Developer Portal -> your application -> Bot -> Reset Token.
TOKEN=

# Local dev database from docker-compose.dev.yml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_PASSWORD=devpassword

# Your test server's id (right-click the server -> Copy Server ID, with Developer
# Mode on). Slash commands appear there instantly; leave empty in production to
# register them globally.
DEV_GUILD_ID=

# Your own Discord user id. Optional: empty means "whoever owns the application".
BOT_OWNER_ID=

# Your own TibiaData from docker-compose.dev.yml: fresh data, so deaths show up within
# about 30 seconds instead of up to 5 minutes. Remove the line to use the public API.
TIBIADATA_HOST=http://127.0.0.1:8081

# With your own TibiaData, allies and enemies (online, or logged out in the last 10
# minutes) are re-checked every FAST_POLL_SECONDS, capped at FAST_POLL_MAX_PER_SECOND
# requests to tibia.com; with more of them online than the cap allows, they take turns.
# Raising the cap risks tibia.com blocking your IP. FAST_POLL_SECONDS=0 turns it off.
# If you hide neutral deaths and levels (/settings -> Neutrals) the bot stops fetching
# neutral players' pages (~1 request/s on a busy world), and 3 is about as safe as 2 was.
# FAST_POLL_SECONDS=5
# FAST_POLL_MAX_PER_SECOND=2

# LOG_LEVEL=INFO
