# Copy to .env and fill in. Never commit .env.

# Bot token: Discord Developer Portal -> your application -> Bot -> Reset Token.
TOKEN=

# Local dev database from docker-compose.dev.yml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_PASSWORD=devpassword

# Testing only: your test server's id (right-click the server -> Copy Server ID, with
# Developer Mode on). Commands then appear instantly, but ONLY in that server. Leave it
# empty to register them for every server the bot is in (Discord can take up to an hour
# the first time); the bot then removes the test-only copies so nothing shows twice.
DEV_GUILD_ID=

# Your own Discord user id. Optional: empty means "whoever owns the application".
BOT_OWNER_ID=

# Your own TibiaData from docker-compose.dev.yml: fresh data, so deaths show up within
# about 30 seconds instead of up to 5 minutes. Remove the line to use the public API.
TIBIADATA_HOST=http://127.0.0.1:8081
# Lookups that needn't be fresh (guild rosters, kill statistics, new list entries, killers'
# levels) go to the public API instead, so they don't spend this machine's tibia.com
# budget. Set it to the same address as TIBIADATA_HOST to send everything there.
# TIBIADATA_BULK_HOST=https://api.tibiadata.com

# With your own TibiaData, enemies (online, or logged out in the last 10 minutes) are
# re-checked every FAST_POLL_SECONDS and allies every ALLY_POLL_SECONDS; enemies always
# go first when the rate can't cover everyone. The request rate to tibia.com adapts:
# it starts at FAST_POLL_MAX_PER_SECOND, climbs 0.25/s every 10 quiet minutes up to
# FAST_POLL_CEILING, and halves (pausing a minute) the moment tibia.com pushes back.
# One rate for all worlds: tibia.com counts per IP. FAST_POLL_SECONDS=0 turns it off.
# FAST_POLL_SECONDS=5
# ALLY_POLL_SECONDS=10
# FAST_POLL_MAX_PER_SECOND=2
# FAST_POLL_CEILING=4

# Mass log alert: at least MASSLOG_MIN_ENEMIES enemies logging in within MASSLOG_MINUTES.
# MASSLOG_MINUTES=5
# MASSLOG_MIN_ENEMIES=5

# LOG_LEVEL=INFO

# Characters a server tracks: listed players plus every member of a listed guild. Only those ONLINE cost anything (one fast check each, see FAST_POLL_* above);
# /hunted and /allies show the live count and estimated traffic in their footer.
# Adds that take a server past TRACKED_WARN_AT get a warning with that estimate.
# TRACKED_WARN_AT=200
