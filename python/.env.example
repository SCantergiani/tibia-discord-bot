# Copy to .env and fill in. Never commit .env.

# Bot token: Discord Developer Portal -> your application -> Bot -> Reset Token.
TOKEN=

# Local dev database from docker-compose.dev.yml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_PASSWORD=devpassword

# Your test server's id (right-click the server -> Copy Server ID, with Developer
# Mode on). Slash commands appear there instantly; leave empty in production to
# register them globally.
DEV_GUILD_ID=

# Your own Discord user id. Optional: empty means "whoever owns the application".
BOT_OWNER_ID=

# Optional. Defaults to the public https://api.tibiadata.com
# TIBIADATA_HOST=

# LOG_LEVEL=INFO
